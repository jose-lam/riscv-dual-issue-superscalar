00500093 // 00: addi x1, x0, 5    (x1 = 5)
00500113 // 04: addi x2, x0, 5    (x2 = 5)
00208663 // 08: beq  x1, x2, +12  (SALTO TOMADO -> genera FLUSH en 0x0C y 0x10)
06300193 // 0c: addi x3, x0, 99   (Víctima 1 - Eliminada por Flush)
06300213 // 10: addi x4, x0, 99   (Víctima 2 - Eliminada por Flush)
00008263 // 14: beq  x1, x0, +4   (SALTO NO TOMADO: 5 != 0 -> SIN Flush, flujo normal)
002100b3 // 18: add  x1, x2, x2   (x1 = 5 + 5 = 10)
002082b3 // 1c: add  x5, x1, x2   (x5 = 10 + 5 = 15)